---
import { PROJECTS } from '../data/projects'

const title = 'Артём Мельник — проекты'
const description = 'Студент первого курса. Приложения, серверы, алгоритмы и один язык программирования — с кодом и тестами.'
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geologica:wght,SHRP@300..800,0..100&display=swap" rel="stylesheet" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' fill='%2324262b'/%3E%3Ctext x='3' y='12.5' font-size='11' font-family='sans-serif' font-weight='700' fill='white'%3EА%3C/text%3E%3C/svg%3E" />
  </head>
  <body>
    <header class="hero">
      <h1>Артём<br />Мельник</h1>
      <div class="intro">
        <p>
          Студент первого курса, факультет информатики и вычислительной техники ДГТУ, Ростов-на-Дону.
          Мне интересно, как вещи устроены внутри — поэтому тут свой язык программирования,
          свой поиск по документам и свой расчёт долгов, а не обёртки над чужими библиотеками.
        </p>
        <p class="links">
          <a href="https://github.com/ex3ittt">GitHub</a>
        </p>
      </div>
    </header>

    <section class="main-project" aria-labelledby="campus">
      <h2 id="campus">Цифровой кампус</h2>
      <p>
        Мой основной проект — iOS-приложение для студентов: настоящее расписание вуза, свободные аудитории
        в реальном времени, напоминания о мероприятиях и помощник на локальной языковой модели, который
        отвечает по открытым данным университета. Flutter и Dart, сервер помощника на FastAPI.
        Код пока закрыт: проект готовится к гранту.
      </p>
    </section>

    <main>
      <h2 class="index-title">Проекты с открытым кодом</h2>
      <ol class="projects">
        {PROJECTS.map((p) => (
          <li class="project" style={`--own: ${p.colour}`}>
            <div class="text">
              <h3>{p.name}</h3>
              <p class="what">{p.what}</p>
              <p class="detail">{p.detail}</p>
              <p class="stack">{p.stack}</p>
              <p class="actions">
                {p.demo && <a href={p.demo}>Открыть</a>}
                {p.repo && <a href={p.repo}>Код на GitHub</a>}
              </p>
            </div>
            <figure class="picture">
              {p.shot ? (
                <img src={p.shot.src} alt={p.shot.alt} loading="lazy" decoding="async" width="800" height="500" />
              ) : (
                <pre class="terminal">{p.terminal}</pre>
              )}
            </figure>
          </li>
        ))}
      </ol>
    </main>

    <footer class="foot">
      <p>У каждого проекта есть README с объяснением, как он устроен, тесты и проверка в GitHub Actions.</p>
    </footer>
  </body>
</html>

<style is:global>
  /* White page, graphite type, one green for links. Each project brings its
     own colour as a strip beside its picture — the projects are the colour. */
  :root {
    --paper: #ffffff;
    --ink: #24262b;
    --muted: #686c74;
    --rule: #e5e6e9;
    --link: #0f7a61;
    color-scheme: light;
  }

  * { box-sizing: border-box; }
  body { margin: 0; background: var(--paper); color: var(--ink); font: 17px/1.6 'Geologica', system-ui, sans-serif; font-weight: 350; }
  a { color: var(--link); text-decoration-thickness: 1.5px; text-underline-offset: 4px; }
  a:hover { text-decoration-thickness: 3px; }
  a:focus-visible { outline: 2px solid var(--link); outline-offset: 3px; border-radius: 2px; }

  .hero, .main-project, main, .foot { max-width: 1180px; margin: 0 auto; padding: 0 32px; }

  .hero { padding-top: 72px; padding-bottom: 56px; display: grid; grid-template-columns: auto 1fr; gap: 24px 64px; align-items: end; border-bottom: 1px solid var(--rule); }
  h1 {
    margin: 0;
    font-size: clamp(56px, 9.5vw, 132px);
    line-height: 0.88;
    font-weight: 750;
    letter-spacing: -0.045em;
    /* Sharp corners on the name only — the rest of the page stays soft. */
    font-variation-settings: 'SHRP' 100;
  }
  .intro { max-width: 52ch; }
  .intro p { margin: 0 0 14px; }
  .links { display: flex; gap: 20px; font-weight: 500; }

  .main-project { padding-top: 44px; padding-bottom: 44px; display: grid; grid-template-columns: 16rem 1fr; gap: 12px 40px; border-bottom: 1px solid var(--rule); }
  .main-project h2 { margin: 0; font-size: 26px; font-weight: 650; letter-spacing: -0.02em; line-height: 1.15; }
  .main-project p { margin: 0; max-width: 64ch; }

  .index-title { margin: 56px 0 8px; font-size: 18px; font-weight: 500; color: var(--muted); }

  .projects { list-style: none; margin: 0; padding: 0; }
  .project { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 32px 56px; padding: 44px 0; border-bottom: 1px solid var(--rule); align-items: start; }
  .project h3 { margin: 0 0 8px; font-size: clamp(28px, 3.4vw, 40px); line-height: 1.05; font-weight: 700; letter-spacing: -0.03em; }
  .what { margin: 0 0 12px; font-size: 19px; font-weight: 450; }
  .detail { margin: 0 0 14px; color: var(--muted); max-width: 50ch; }
  .stack { margin: 0 0 16px; font-size: 15px; color: var(--muted); }
  .actions { margin: 0; display: flex; gap: 22px; font-weight: 500; }

  .picture { margin: 0; position: relative; padding-left: 10px; }
  .picture::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--own); }
  .picture img { display: block; width: 100%; height: auto; border: 1px solid var(--rule); }
  .terminal {
    margin: 0;
    padding: 20px 22px;
    background: #1d2026;
    color: #dfe3ea;
    font: 13.5px/1.6 ui-monospace, 'SF Mono', Menlo, monospace;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    min-height: 200px;
  }

  .foot { padding-top: 40px; padding-bottom: 64px; color: var(--muted); font-size: 15px; }

  @media (max-width: 860px) {
    .hero, .main-project, main, .foot { padding: 0 18px; }
    .hero { grid-template-columns: 1fr; padding-top: 44px; padding-bottom: 36px; }
    .main-project { grid-template-columns: 1fr; padding-top: 32px; padding-bottom: 32px; }
    .project { grid-template-columns: 1fr; gap: 20px; padding: 32px 0; }
    .picture { order: -1; }
  }
</style>
